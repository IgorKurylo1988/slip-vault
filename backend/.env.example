# -------------------------------------------------------------
# LLM Configuration (LiteLLM)
# -------------------------------------------------------------
# LLM_MODEL: Model identifier format is "provider/model_name"
# Examples:
#   - gemini/gemini-2.5-flash
#   - bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0 (Uses implicit AWS credentials)
#   - openai/gpt-4o
#   - vertex_ai/gemini-2.5-flash (Uses Application Default Credentials)
LLM_MODEL=gemini/gemini-2.5-flash

# API Keys depending on the provider chosen above:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------
# Active Storage & Messaging Providers Setup
# -------------------------------------------------------------
STORAGE_PROVIDER=GCS
MESSAGING_PROVIDER=GCP_PUBSUB

# -------------------------------------------------------------
# GCP Configuration (Shared between local emulator & production cloud)
# -------------------------------------------------------------
GCP_PROJECT_ID=slip-vault-project
GCP_GCS_BUCKET=slip-vault-bucket
GCP_PUBSUB_TOPIC_ID=slip-vault-topic
GCP_PUBSUB_SUBSCRIPTION_ID=slip-vault-sub

# -------------------------------------------------------------
# Local Development Emulation (GCP Emulators via Docker Compose)
# -------------------------------------------------------------
# Leave these uncommented for local testing (they redirect standard GCP SDK calls to container services)
STORAGE_EMULATOR_HOST=http://localhost:4443
PUBSUB_EMULATOR_HOST=localhost:8085

# -------------------------------------------------------------
# Production GCP Deployment Configuration
# -------------------------------------------------------------
# For production deployment in GCP, delete or comment out the local emulators above:
# STORAGE_EMULATOR_HOST=
# PUBSUB_EMULATOR_HOST=
# Credentials will be resolved implicitly using standard Google Application Default Credentials (ADC).
