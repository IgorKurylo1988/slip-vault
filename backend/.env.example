# -------------------------------------------------------------
# LLM Configuration (LiteLLM)
# -------------------------------------------------------------
# LLM_MODEL: Model identifier format is "provider/model_name"
# Examples:
#   - gemini/gemini-2.5-flash
#   - bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0
#   - openai/gpt-4o
#   - vertex_ai/gemini-2.5-flash
LLM_MODEL=gemini/gemini-2.5-flash

# API Keys depending on the provider chosen above:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------
# Active Storage/Messaging Providers Setup
# -------------------------------------------------------------
# STORAGE_PROVIDER: select GCS for Google, S3 for AWS, or BASE64 for local mock storage
STORAGE_PROVIDER=S3

# MESSAGING_PROVIDER: select GCP_PUBSUB for Google, SQS for AWS, or DUMMY for local mock testing
MESSAGING_PROVIDER=SQS

# -------------------------------------------------------------
# AWS Configuration (S3, SQS, and Bedrock LLM)
# -------------------------------------------------------------
# Note: AWS credentials are loaded implicitly from standard locations 
# (e.g. ~/.aws/credentials, environment variables, or IAM role).
# These are shared by S3, SQS, and Bedrock (if Bedrock LLM is selected).
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name_here
AWS_SQS_QUEUE_URL=your_sqs_queue_url_here

# -------------------------------------------------------------
# GCP Configuration (GCS, Pub/Sub, and Vertex AI LLM)
# -------------------------------------------------------------
# Note: GCP credentials are loaded implicitly using standard Google Application Default Credentials (ADC).
# These are shared by GCS, Pub/Sub, and Vertex AI (if Vertex AI LLM is selected).
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_GCS_BUCKET=your_gcs_bucket_name_here
GCP_PUBSUB_TOPIC_ID=your_pubsub_topic_id_here
GCP_PUBSUB_SUBSCRIPTION_ID=your_pubsub_subscription_id_here
